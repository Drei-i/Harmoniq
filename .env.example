PORT=3000
NODE_ENV=development

# Register at https://acoustid.org/new-application
ACOUSTID_API_KEY=your_acoustid_application_key

# Register at https://developer.jamendo.com/v3.0 (optional — uses Internet Archive if unset)
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Optional: override bundled fpcalc path
# FPCALC_PATH=C:\path\to\fpcalc.exe
